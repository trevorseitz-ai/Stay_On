default_platform(:ios)

WORKSPACE = "App.xcworkspace"
SCHEME    = "App"
XCODEPROJ = "App.xcodeproj"

# Loads the App Store Connect API key from env vars (set in the shell or a
# .env file fastlane auto-reads). Required by the build + upload lanes.
def load_asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_PATH"),
    in_house: false
  )
end

platform :ios do
  desc "Rebuild the web bundle and sync it into the iOS project"
  lane :sync_web do
    # fastlane runs from ios/App; the Capacitor project root is two up.
    sh("cd ../.. && npm run build && npx cap sync ios")
  end

  desc "Set the build number to a UTC timestamp (monotonic, no state to track)"
  lane :bump do
    increment_build_number(
      xcodeproj: XCODEPROJ,
      build_number: Time.now.utc.strftime("%Y%m%d%H%M")
    )
  end

  desc "Build a signed App Store .ipa into ./build"
  lane :build do
    load_asc_api_key
    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      export_method: "app-store",
      output_directory: "./build",
      clean: true
    )
  end

  desc "Sync web, bump build number, build, and upload to TestFlight"
  lane :beta do
    sync_web
    bump
    build
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY]
    )
  end
end
