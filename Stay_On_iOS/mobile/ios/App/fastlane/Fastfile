# Setup: App Store Connect → Users and Access → Integrations → App Store
# Connect API → create an "App Manager" key, download the .p8 once, then put
# these in fastlane/.env (git-ignored):
#   ASC_KEY_ID=...
#   ASC_ISSUER_ID=...
#   ASC_KEY_PATH=/absolute/path/to/AuthKey_XXXXXXXXXX.p8
# Verify with:  bundle exec fastlane auth_check
# (README.md in this dir is auto-generated by fastlane — don't edit it.)

default_platform(:ios)

WORKSPACE = "App.xcworkspace"
SCHEME    = "App"
XCODEPROJ = "App.xcodeproj"

# Loads the App Store Connect API key from env vars (set in the shell or a
# .env file fastlane auto-reads). Required by the build + upload lanes.
def load_asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_PATH"),
    in_house: false
  )
end

platform :ios do
  desc "Rebuild the web bundle and sync it into the iOS project"
  lane :sync_web do
    # `sh` runs from the fastlane/ dir; the Capacitor project root (mobile/,
    # holding package.json + capacitor.config) is three levels up.
    web_root = File.expand_path("../../..", __dir__)
    sh("cd #{web_root.shellescape} && npm run build && npx cap sync ios")
  end

  desc "Verify the App Store Connect API key authenticates"
  lane :auth_check do
    load_asc_api_key
    n = latest_testflight_build_number(
      app_identifier: "com.trevorseitz.stayon",
      api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY]
    )
    UI.success("Auth OK — latest TestFlight build number: #{n}")
  end

  desc "Set the build number to a UTC timestamp (monotonic, no state to track)"
  lane :bump do
    # skip_info_plist keeps App/Info.plist on the $(CURRENT_PROJECT_VERSION)
    # build-setting reference instead of hardcoding the timestamp into it.
    increment_build_number(
      xcodeproj: XCODEPROJ,
      build_number: Time.now.utc.strftime("%Y%m%d%H%M"),
      skip_info_plist: true
    )
  end

  desc "Build a signed App Store .ipa into ./build"
  lane :build do
    load_asc_api_key
    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      export_method: "app-store",
      output_directory: "./build",
      clean: true
    )
  end

  desc "Sync web, bump build number, build, and upload to TestFlight"
  lane :beta do
    sync_web
    bump
    build
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY]
    )
  end
end
